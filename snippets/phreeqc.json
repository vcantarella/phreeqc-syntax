{
  "SOLUTION block": {
    "prefix": "solution",
    "body": [
      "SOLUTION ${1:1} ${2:description}",
      "    temp      ${3:25.0}",
      "    pH        ${4:7.0}",
      "    pe        ${5:4.0}",
      "    units     ${6|mmol/kgw,mol/kgw,ppm,mg/L,ug/L,mol/L|}",
      "    ${7:Ca}        ${8:1.0}",
      "$0"
    ],
    "description": "Initial solution composition (SOLUTION data block)"
  },
  "EQUILIBRIUM_PHASES block": {
    "prefix": "equilibrium_phases",
    "body": [
      "EQUILIBRIUM_PHASES ${1:1} ${2:description}",
      "    ${3:Calcite}    ${4:0.0}    ${5:10.0}",
      "$0"
    ],
    "description": "Pure-phase assemblage: phase, target SI, amount (moles)"
  },
  "KINETICS + RATES pair": {
    "prefix": "kinetics-rates",
    "body": [
      "KINETICS ${1:1}",
      "    ${2:Calcite}",
      "        -m0    ${3:1.0}",
      "        -parms ${4:1.0}",
      "    -steps ${5:86400} in ${6:10} steps",
      "",
      "RATES",
      "    ${2:Calcite}",
      "    -start",
      "10 rate = ${7:1e-9} * (1 - SR(\"${2:Calcite}\"))",
      "20 moles = rate * TIME",
      "30 SAVE moles",
      "    -end",
      "$0"
    ],
    "description": "Kinetic reactant with its BASIC rate expression"
  },
  "TRANSPORT block": {
    "prefix": "transport",
    "body": [
      "TRANSPORT",
      "    -cells                 ${1:10}",
      "    -shifts                ${2:20}",
      "    -time_step             ${3:3600}",
      "    -lengths               ${4:1.0}",
      "    -dispersivities        ${5:0.1}",
      "    -flow_direction        ${6|forward,back,diffusion_only|}",
      "    -boundary_conditions   ${7|flux,constant,closed|} ${8|flux,constant,closed|}",
      "    -diffusion_coefficient ${9:0.3e-9}",
      "    -punch_cells           ${10:10}",
      "    -punch_frequency       ${11:1}",
      "$0"
    ],
    "description": "1D advective-dispersive transport"
  },
  "SELECTED_OUTPUT block": {
    "prefix": "selected_output",
    "body": [
      "SELECTED_OUTPUT ${1:1}",
      "    -file                 ${2:output.tsv}",
      "    -reset                ${3|true,false|}",
      "    -totals               ${4:Ca C(4)}",
      "    -molalities           ${5:Ca+2 HCO3-}",
      "    -saturation_indices   ${6:Calcite CO2(g)}",
      "$0"
    ],
    "description": "Tab-separated results file definition"
  },
  "PHASES block": {
    "prefix": "phases",
    "body": [
      "PHASES",
      "${1:Phase_name}",
      "    ${2:CaCO3 = Ca+2 + CO3-2}",
      "    -log_k     ${3:-8.48}",
      "    -delta_h   ${4:-2.297} kcal",
      "$0"
    ],
    "description": "Define or override a mineral/gas phase"
  },
  "EXCHANGE block": {
    "prefix": "exchange",
    "body": [
      "EXCHANGE ${1:1}",
      "    ${2:X}    ${3:0.0011}",
      "    -equilibrate ${4:1}",
      "$0"
    ],
    "description": "Exchanger assemblage equilibrated with a solution"
  },
  "SURFACE block": {
    "prefix": "surface",
    "body": [
      "SURFACE ${1:1}",
      "    ${2:Hfo_w}    ${3:0.2}    ${4:600}    ${5:0.09}",
      "    -equilibrate ${6:1}",
      "$0"
    ],
    "description": "Surface assemblage: site, sites (mol), area (m2/g), mass (g)"
  },
  "REACTION block": {
    "prefix": "reaction",
    "body": [
      "REACTION ${1:1}",
      "    ${2:NaCl}    ${3:1.0}",
      "    ${4:0.001} moles in ${5:10} steps",
      "$0"
    ],
    "description": "Irreversible reaction added in steps"
  },
  "Speciation run scaffold": {
    "prefix": "speciation-run",
    "body": [
      "TITLE ${1:Speciation calculation}",
      "DATABASE ${2:phreeqc.dat}",
      "SOLUTION 1 ${3:sample}",
      "    temp      ${4:25.0}",
      "    pH        ${5:7.0}",
      "    units     ${6|mmol/kgw,ppm,mg/L|}",
      "    ${7:Ca}        ${8:1.0}",
      "END",
      "$0"
    ],
    "description": "Minimal complete input file for a speciation calculation"
  }
}
