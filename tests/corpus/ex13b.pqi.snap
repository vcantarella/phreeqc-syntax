#               ^^^^ source.phreeqc
#                   ^^^^^^^^^^^^^^^^^^^^^^^^ source.phreeqc comment.line.number-sign.phreeqc
>   Cl       1.0    # Cl has Retardation = 1, stagnant exchange
#^^^^^^^^^^^^ source.phreeqc
#            ^^^ source.phreeqc constant.numeric.phreeqc
#               ^^^^ source.phreeqc
#                   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.phreeqc comment.line.number-sign.phreeqc
