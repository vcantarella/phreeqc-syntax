#^^^^^^^^^^^^^^^ source.phreeqc keyword.control.phreeqc
>        SurfOH = SurfOH
#^^^^^^^^^^^^^^^^^^^^^^^^ source.phreeqc
>                log_k   0.0
#^^^^^^^^^^^^^^^^^^^^^^^^ source.phreeqc
#                        ^^^ source.phreeqc constant.numeric.phreeqc
>        SurfOH  + H+ = SurfOH2+
#^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.phreeqc
>                log_k   7.29
#^^^^^^^^^^^^^^^^^^^^^^^^ source.phreeqc
#                        ^^^^ source.phreeqc constant.numeric.phreeqc
>        SurfOH = SurfO- + H+
#^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.phreeqc
>                log_k   -8.93
#^^^^^^^^^^^^^^^^^^^^^^^^ source.phreeqc
#                        ^^^^^ source.phreeqc constant.numeric.phreeqc
>        SurfOH + AsO4-3 + 3H+ = SurfH2AsO4 + H2O
#^^^^^^^^^^^^^^^^^^^^^^ source.phreeqc
#                      ^ source.phreeqc constant.numeric.phreeqc
#                       ^^^^^^^^^^^^^^^^^^^^^^^^^^ source.phreeqc
>                log_k   29.31
#^^^^^^^^^^^^^^^^^^^^^^^^ source.phreeqc
#                        ^^^^^ source.phreeqc constant.numeric.phreeqc
>        SurfOH + AsO4-3 + 2H+ = SurfHAsO4- + H2O
#^^^^^^^^^^^^^^^^^^^^^^ source.phreeqc
#                      ^ source.phreeqc constant.numeric.phreeqc
#                       ^^^^^^^^^^^^^^^^^^^^^^^^^^ source.phreeqc
>                log_k   23.51
#^^^^^^^^^^^^^^^^^^^^^^^^ source.phreeqc
#                        ^^^^^ source.phreeqc constant.numeric.phreeqc
>        SurfOH + AsO4-3 = SurfOHAsO4-3
#^^^^^^^^^^^^^^^^^^^^^^ source.phreeqc
#                      ^ source.phreeqc constant.numeric.phreeqc
