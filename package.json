{
  "name": "phreeqc-syntax",
  "displayName": "PHREEQC",
  "version": "0.1.0",
  "publisher": "VitorCantarella",
  "description": "PHREEQC language support: syntax highlighting, autocomplete, hover documentation from the USGS manual, and snippets.",
  "categories": ["Programming Languages", "Snippets"],
  "keywords": ["phreeqc", "geochemistry", "hydrogeology", "reactive transport", "usgs"],
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [{
      "id": "phreeqc",
      "aliases": ["PHREEQC", "phreeqc"],
      "extensions": [".phr", ".ppi", ".pqi", ".phrq", ".dat", ".out"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "phreeqc",
      "scopeName": "source.phreeqc",
      "path": "./phreeqc.tmLanguage.json"
    }],
    "snippets": [{
      "language": "phreeqc",
      "path": "./snippets/phreeqc.json"
    }]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "esbuild src/core.ts --bundle --outfile=dist-test/core.mjs --format=esm --platform=neutral",
    "test": "node --test tests/*.test.mjs && vscode-tmgrammar-test -g phreeqc.tmLanguage.json \"tests/grammar/*.pqi\" && vscode-tmgrammar-snap -g phreeqc.tmLanguage.json \"tests/corpus/*.pqi\"",
    "snap-update": "vscode-tmgrammar-snap -g phreeqc.tmLanguage.json \"tests/corpus/*.pqi\" --updateSnapshot",
    "vscode:prepublish": "npm run typecheck && npm test && npm run build",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.32.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.0",
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/vcantarella/phreeqc-syntax"
  },
  "bugs": {
    "url": "https://github.com/vcantarella/phreeqc-syntax/issues"
  },
  "homepage": "https://github.com/vcantarella/phreeqc-syntax#readme",
  "license": "MIT"
}
